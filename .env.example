# EvidenceGap AI 2026 — Environment Configuration
# Copy this file to .env and fill in your values

# === Google Gemini API ===
GEMINI_API_KEY=your_gemini_api_key_here

# === BioPortal API (optional — enhances ontology mapping) ===
BIOPORTAL_API_KEY=your_bioportal_api_key_here

# === PubMed E-utilities ===
# NCBI recommends providing email and optionally an API key
PUBMED_EMAIL=your_email@example.com
PUBMED_API_KEY=your_ncbi_api_key_here

# === Application Settings ===
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/evidencegap.db

# === Embedding Model ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPECTER_MODEL=allenai/specter2

# === NLI Model ===
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# === Data Collection ===
PUBMED_BATCH_SIZE=500
PUBMED_RATE_LIMIT_PER_SECOND=3
PMC_FULLTEXT_BATCH_SIZE=50
MAX_ARTICLES=10000

# === Topic Modeling ===
BERTOPIC_MIN_TOPIC_SIZE=10
BERTOPIC_NR_TOPICS=auto
LDA_NUM_TOPICS=20

# === FAISS ===
FAISS_INDEX_TYPE=IVFFlat
FAISS_NPROBE=10

# === Hypothesis Generation ===
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192
MAX_HYPOTHESES_PER_RUN=10

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
